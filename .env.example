# Copie para .env (nunca comitado) e preencha o que for usar.

# Necessária só para `fireball finalize --backend groq`.
# https://console.groq.com/keys
GROQ_API_KEY=

# Provedor de resumo 'openai_api' — só se você preferir manter a chave fora do
# ~/.fireball/settings.json. A configuração da janela vem primeiro; estas
# variáveis entram quando o campo lá está vazio.
FIREBALL_OPENAI_BASE_URL=
FIREBALL_OPENAI_API_KEY=
FIREBALL_OPENAI_MODEL=

# Opcional: arquivo GGUF local do Sortformer. Vazio deixa o nemo-speech usar
# e baixar o modelo padrão indexado por ele.
FIREBALL_SORTFORMER_MODEL=
